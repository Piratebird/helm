# Helm secret store template.
#
# Copy this file to <config_dir>/secrets.env (e.g. ~/.config/helm/secrets.env)
# and fill in your values. The wizard creates it automatically with 0600
# permissions, and it is never tracked by git. The container env takes
# precedence; the file is a convenience for native execution.

# Jackett
JACKETT_API_KEY=abcdd123454dsdhf
JACKETT_PASSWORD=

# qBittorrent
QB_PASSWORD=mypassword

# --- Non-secret settings stay in config.json, not here ---
# JACKETT_URL=http://localhost:9117
# QB_WEBUI=http://localhost:8080
# QB_USERNAME=admin